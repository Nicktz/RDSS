<configuration>
	<configSections>
  <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,Log4net"/>
  </configSections>
	<appSettings>
	</appSettings>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<qualifyAssembly partialName="SIM.ServerInterface" fullName="SIM.ServerInterface,Version=1.0.0.0,Culture=neutral,PublicKeyToken=8637e262896e74fe" />
		</assemblyBinding>
	</runtime>
  <log4net>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="LogFile" />
    </root>
    <appender name="LogFile" type="log4net.Appender.RollingFileAppender" >
      <file value="${USERPROFILE}\Local Settings\Application Data\SIM\RTD\Logs\RTD.log" />
      <appendToFile value="true" />
      <maximumFileSize value="5MB" />
      <maxSizeRollBackups value="10" />

      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date %level [%logger] - %message%newline" />
      </layout>
    </appender>
  </log4net>
</configuration>